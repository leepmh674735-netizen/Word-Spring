import org.springframework.beans.factory.config.BeanDefinition;
import org.springframework.beans.factory.config.RuntimeBeanReference;
import org.springframework.beans.factory.parsing.BeanComponentDefinition;
import org.springframework.beans.factory.parsing.CompositeComponentDefinition;
import org.springframework.beans.factory.support.RootBeanDefinition;

private RootBeanDefinition createDef(Class<?> clazz) {
    RootBeanDefinition def = new RootBeanDefinition(clazz);
    def.setSource(this.src); // 'src'가 클래스의 멤버 변수라고 가정합니다.
    def.setRole(BeanDefinition.ROLE_INFRASTRUCTURE); // 오타 수정 및 메서드 변경 (setSource -> setRole)
    return def;
}

private void addProp(RootBeanDefinition def, String name, Object value) {
    def.getPropertyValues().add(name, value); // 메서드명 수정 (getPropertyValue -> getPropertyValues)
}

private void addRuntimeProp(RootBeanDefinition def, String name, String value) {
    addProp(def, name, new RuntimeBeanReference(value)); // 오타 수정
}

private void addOrderProp(RootBeanDefinition def, int offset) {
    addProp(def, "order", this.baseOrder + offset); // 'baseOrder'가 멤버 변수라고 가정합니다.
}

private String registerWithGeneratedName(RootBeanDefinition def) {
    return this.parserCtx.getReaderContext().registerWithGeneratedName(def); // 오타 수정
}

private void doLogicalView(
        RootBeanDefinition sdef, String sname, // 매개변수 이름을 사용처(sname)에 맞게 수정
        RootBeanDefinition idef, String iname,
        RootBeanDefinition adef, String aname,
        String tagName) { // 로거와 생성자에 필요한 'tagName' 매개변수 추가

    // 생성자 파라미터 규칙에 맞게 수정 (구성 요소 이름과 소스 오브젝트 필요)
    CompositeComponentDefinition ldef = new CompositeComponentDefinition(tagName, this.src); 
    
    addComp(ldef, sdef, sname); // 메서드명 오타 수정 (addComop -> addComp)
    addComp(ldef, idef, iname); // 메서드명 오타 수정
    addComp(ldef, adef, aname);
    
    this.parserCtx.registerComponent(ldef);
    log.info("Registered {} components", tagName); // 문자열 포맷팅 콤마(,) 누락 수정
}

private void addComp(CompositeComponentDefinition ldef, RootBeanDefinition def, String name) {
    ldef.addNestedComponent(new BeanComponentDefinition(def, name)); // 클래스명 오타 수정
}