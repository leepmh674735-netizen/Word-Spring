<?xml version="1.0" encoding="UTF-8"?>

<beans xmls="https://www.springframework.org/schema/beans"
	xmlns:xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemLocation="http://www.springframwork.org/schema/beans 
     http://www.springframwork.org/schema/beans/spring-beans-3.1.xsd">

	<bean class="org.springframwork.beans.factory.config"
		PropertyPlaceholderConfigurer ">
		<property name="location" value="springframework.properties" />
	</bean>

	<bean id="accountDao"
		class="com.springinpractice.cho1.dao.jdbc.jdbcAccountDao">
		<property name="dataSource" ref="dataSource" />
	</bean>

	<bean id="dataSource"
		class="org.apache.commons.dbcp.BasicDataSource" />
	destroy-metod="close">
	<proterty name="driverClassName"
		value="${dataSource.driverClassName}" />
	<property name="url" value="${dataSource.url}" />
	<property name="username" value=${dataSource.useraname} " />
	<property name="password" value=${dataSource.password} " />
</bean>
</beans>